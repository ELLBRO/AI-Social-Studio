# ==================================================
# AI SOCIAL STUDIO — ENVIRONMENT CONFIGURATION
# ==================================================

# Application
APP_NAME="AI Social Studio"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
SECRET_KEY=change-this-to-a-very-secure-32-byte-hex-secret-in-production
ENCRYPTION_KEY=dGhpcy1pcy1hLXNhbXBsZS0zMi1ieXRlLWtleS0xMjM0NTY= # Base64 encoded 32-byte key for AES-256

# Database
# Production PostgreSQL example: postgresql+psycopg://postgres:postgres@localhost:5432/ai_social_studio
# Default for instant local dev without Docker: sqlite:///./ai_social_studio.db
DATABASE_URL=sqlite:///./ai_social_studio.db
DB_ECHO=false

# Redis (for async worker & cache)
REDIS_URL=redis://localhost:6379/0

# Authentication & JWT
JWT_SECRET_KEY=super-secret-jwt-signing-key-for-social-studio-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Providers (Provider-Independent: supports openai, anthropic, gemini, or mock)
DEFAULT_AI_PROVIDER=mock # Options: openai, anthropic, gemini, mock
OPENAI_API_KEY=sk-placeholder-openai-key
ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-key
GEMINI_API_KEY=AIzaSy-placeholder-gemini-key

# Video Generation (Provider-Independent: supports runway, luma, replicate, or mock)
DEFAULT_VIDEO_PROVIDER=mock # Options: runway, luma, replicate, mock
RUNWAY_API_KEY=key_placeholder_runway
LUMA_API_KEY=key_placeholder_luma
REPLICATE_API_TOKEN=r8_placeholder_replicate

# Object Storage (local or s3)
STORAGE_PROVIDER=local # Options: local, s3
LOCAL_STORAGE_DIR=./uploads
AWS_ACCESS_KEY_ID=placeholder_aws_key
AWS_SECRET_ACCESS_KEY=placeholder_aws_secret
AWS_REGION=us-east-1
S3_BUCKET_NAME=ai-social-studio-media

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_placeholder_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret
STRIPE_PRICE_STARTER_MONTHLY=price_placeholder_starter_monthly
STRIPE_PRICE_STARTER_YEARLY=price_placeholder_starter_yearly
STRIPE_PRICE_PRO_MONTHLY=price_placeholder_pro_monthly
STRIPE_PRICE_PRO_YEARLY=price_placeholder_pro_yearly
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_placeholder_enterprise_monthly
STRIPE_PRICE_ENTERPRISE_YEARLY=price_placeholder_enterprise_yearly

# Social Platform OAuth (Official APIs)
# Meta (Instagram & Facebook)
META_CLIENT_ID=placeholder_meta_client_id
META_CLIENT_SECRET=placeholder_meta_client_secret
META_REDIRECT_URI=http://localhost:3000/api/auth/callback/meta

# TikTok
TIKTOK_CLIENT_KEY=placeholder_tiktok_key
TIKTOK_CLIENT_SECRET=placeholder_tiktok_secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/callback/tiktok

# YouTube (Google OAuth)
GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# LinkedIn
LINKEDIN_CLIENT_ID=placeholder_linkedin_client_id
LINKEDIN_CLIENT_SECRET=placeholder_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/callback/linkedin

# X (Twitter)
X_CLIENT_ID=placeholder_x_client_id
X_CLIENT_SECRET=placeholder_x_client_secret
X_REDIRECT_URI=http://localhost:3000/api/auth/callback/x

# Next.js Public Vars
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
